<c:FragmentDefinition xmlns="sap.m" xmlns:c="sap.ui.core"><Dialog title="{i18n>SELECT_SUMMARIZE_SECTIONS}" id="SelectSections" contentWidth="25%" c:require="{formatMessage:'sap/base/strings/formatMessage'}"><content><MessageStrip id="SelectSectionInfo" text="{i18n>SELECT_SECTION_INFO}" showIcon="true" type="Information" class="sapUiTinyMarginTop sapUiTinyMarginBeginEnd" visible="{= ${local>/sections/allSelected} ? false : true }"/><CheckBox id="SelectAllSections" text="{= formatMessage(${i18n>SELECT_ALL},${local>/sections/selectCount}, ${local>/sections/totalCount})}" selected="{local>/sections/allSelected}" partiallySelected="{local>/sections/partiallySelected}" select="onSelectAllSections" visible="{= !${local>/sections/busyState}}" ariaLabelledBy="SectionsTree" ariaDescribedBy="SelectSectionInfo" class="sapUiSmallMarginTop sapUiMediumMarginBeginEnd"/><Tree id="SectionsTree" items="{path: 'local>/sections/sectionTree/', parameters: {numberOfExpandedLevels: 1 }}" mode="MultiSelect" busy="{local>/sections/busyState}" noDataText="{i18n>LOADING_SECTIONS}" includeItemInSelection="true" selectionChange="onSelectionChange"><StandardTreeItem id="TreeItems" title="{local>sectionName}" selected="{local>selected}"/></Tree></content><beginButton><Button id="Continue" text="{i18n>CONTINUE}" type="Emphasized" enabled="{= !${local>/sections/busyState}}" press="onSectionSelectContinue"/></beginButton><endButton><Button id="Cancel" text="{i18n>CANCEL}"/></endButton></Dialog></c:FragmentDefinition>