    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "${sap.ui5.dist.version}",
            "libs": {
                "ux.eng.fioriai.reuse": {},
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.richtexteditor": { "lazy": true },
                "sap.suite.ui.commons": { "lazy": true }
