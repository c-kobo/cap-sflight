                    "el",
                    "en",
                    "es",
                    "fi",
                    "fr",
                    "hr",
                    "hu",
                    "it",
                    "iw",
                    "ja",
                    "kk",
                    "ko",
                    "ms",
                    "nl",
                    "no",
                    "pl",
                    "pt",
                    "ro",
                    "ru",
                    "sh",
                    "sk",
                    "sl",
                    "sv",
                    "th",
                    "tr",
                    "uk",
                    "zh_CN",
                    "zh_TW",
                    ""
                ],
                "fallbackLocale": ""
            },
            "css": true,
            "content": {
                "controls": [],
                "elements": [],
                "types": [],
                "interfaces": []
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
