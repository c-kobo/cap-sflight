    "_version": "1.69.0",
    "sap.app": {
        "id": "ux.eng.fioriai.reuse",
        "type": "library",
        "title": "{{TITLE}}",
        "description": "{{DESCRIPTION}}",
        "applicationVersion": {
            "version": "${project.version}"
        },
        "dataSources": {
            "service": {
                "uri": "/sap/opu/odata4/sap/aiu_ui_prompt/srvd/sap/aiu_ui_prompt/0001/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
